generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "windows", "darwin-arm64", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DeletionStatus {
  NotDeleted
  Deleted
}

enum PaymentStatus {
  Confirmed
  Pending
}

enum SubscriptionPeriod {
  DAY
  WEEK
  MONTH
}

enum PaymentSystem {
  STRIPE
  PAYPAL
  CREDIT_CARD
}

enum NotificationType {
  SEVEN_DAYS_BEFORE
  ONE_DAYS_BEFORE
  IN_ONE_DAY
  SUBSCRIPTION_IS_ACTIVE
}

model User {
  id                    Int                        @id @default(autoincrement())
  username              String                     @unique
  email                 String                     @unique
  firstName             String?
  lastName              String?
  dateOfBirth           DateTime?
  country               String?
  city                  String?
  aboutMe               String?
  passwordHash          String?
  hasActiveSubscription Boolean                    @default(false)
  deletionStatus        DeletionStatus             @default(NotDeleted)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  userMetadata          UserMetadata?              @relation("UserMetadata")
  authAccounts          AuthAccount[]              @relation("AuthAccounts")
  devices               Device[]                   @relation("Devices")
  posts                 Post[]
  userAvatars           UserAvatar[]               @relation("UserAvatars")
  subscription          UserSubscription[]         @relation("UserSubscription")
  payments              SubscriptionTransactions[] @relation("SubscriptionTransactions")
  otification           UserNotification[]         @relation("UserNotification")
}

model UserMetadata {
  userId                      Int       @id
  user                        User      @relation("UserMetadata", fields: [userId], references: [id])
  emailConfirmationCode       String?   @db.VarChar(255)
  emailConfirmationExpiration DateTime?
  isEmailConfirmed            Boolean   @default(false)
  passwordRecoveryCode        String?   @db.VarChar(255)
  passwordRecoveryExpiration  DateTime?
}

model UserAvatar {
  id             Int            @id @default(autoincrement())
  userId         Int
  avatarUrl      String
  createdAt      DateTime       @default(now())
  deletionStatus DeletionStatus @default(NotDeleted)
  user           User           @relation("UserAvatars", fields: [userId], references: [id])
}

model AuthAccount {
  id         Int      @id @default(autoincrement())
  provider   String
  providerId String
  userId     Int
  user       User     @relation("AuthAccounts", fields: [userId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([provider, providerId])
}

model Post {
  id             Int            @id @default(autoincrement())
  userId         Int
  description    String?
  imageUrl       String[]       @default([])
  createdAt      DateTime       @default(now())
  deletionStatus DeletionStatus @default(NotDeleted)
  user           User           @relation(fields: [userId], references: [id])
}

model Device {
  id             String         @id @db.Uuid
  userId         Int
  title          String
  ip             String
  lastActiveDate DateTime
  expirationDate DateTime
  deletionStatus DeletionStatus @default(NotDeleted)
  user           User           @relation("Devices", fields: [userId], references: [id])
}

model AvailableSubscription {
  id     Int                @id @default(autoincrement())
  title  String
  price  Int
  period SubscriptionPeriod

  subscriptionTransactions SubscriptionTransactions[] @relation("AvailableSubscription_Transactions")
  userSubscriptions        UserSubscription[]         @relation("AvailableSubscription_UserSubscriptions")
}

model SubscriptionTransactions {
  id                    Int           @id @default(autoincrement())
  subscriptionId        Int
  userId                Int
  externalTransactionId String?
  paymentSystem         PaymentSystem
  status                PaymentStatus @default(Pending)
  paymentDate           DateTime?
  createdAt             DateTime      @default(now())
  url                   String?

  user                  User                  @relation("SubscriptionTransactions", fields: [userId], references: [id])
  availableSubscription AvailableSubscription @relation("AvailableSubscription_Transactions", fields: [subscriptionId], references: [id])
  userSubscription      UserSubscription?     @relation("Transaction_UserSubscription")
}

model UserSubscription {
  id                    Int       @id @default(autoincrement())
  userId                Int
  subscriptionId        Int
  transactionId         Int       @unique
  subscriptionStartDate DateTime
  subscriptionEndDate   DateTime
  nextPaymentDate       DateTime?
  autoRenewal           Boolean   @default(true)
  notified              Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                     User                     @relation("UserSubscription", fields: [userId], references: [id])
  availableSubscription    AvailableSubscription    @relation("AvailableSubscription_UserSubscriptions", fields: [subscriptionId], references: [id])
  subscriptionTransactions SubscriptionTransactions @relation("Transaction_UserSubscription", fields: [transactionId], references: [id])
}

model UserNotification {
  id         Int              @id @default(autoincrement())
  userId     Int
  notifyType NotificationType
  isRead     Boolean          @default(false)
  targetDate DateTime
  notifyAt   DateTime         @default(now())
  user       User             @relation("UserNotification", fields: [userId], references: [id])
}
