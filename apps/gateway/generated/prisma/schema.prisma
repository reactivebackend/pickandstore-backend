generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "windows", "darwin-arm64"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DeletionStatus {
  NotDeleted
  Deleted
}

enum PaymentStatus {
  Confirmend
  PandingPayment
  Failed
}

model User {
  id             Int            @id @default(autoincrement())
  username       String         @unique
  email          String         @unique
  firstName      String?
  lastName       String?
  dateOfBirth    DateTime?
  country        String?
  city           String?
  aboutMe        String?
  passwordHash   String?
  deletionStatus DeletionStatus @default(NotDeleted)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  userMetadata   UserMetadata?  @relation("UserMetadata")
  authAccounts   AuthAccount[]  @relation("AuthAccounts")
  devices        Device[]       @relation("Devices")
  posts          Post[]
  userAvatars    UserAvatar[]   @relation("UserAvatars")
  subscription   Subscription[] @relation("Subscription")
  payments       Payments[]     @relation("Payments")
}

model UserMetadata {
  userId                      Int       @id
  user                        User      @relation("UserMetadata", fields: [userId], references: [id])
  emailConfirmationCode       String?   @db.VarChar(255)
  emailConfirmationExpiration DateTime?
  isEmailConfirmed            Boolean   @default(false)
  passwordRecoveryCode        String?   @db.VarChar(255)
  passwordRecoveryExpiration  DateTime?
}

model UserAvatar {
  id             Int            @id @default(autoincrement())
  userId         Int
  avatarUrl      String
  createdAt      DateTime       @default(now())
  deletionStatus DeletionStatus @default(NotDeleted)
  user           User           @relation("UserAvatars", fields: [userId], references: [id])
}

model AuthAccount {
  id         Int      @id @default(autoincrement())
  provider   String
  providerId String
  userId     Int
  user       User     @relation("AuthAccounts", fields: [userId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([provider, providerId])
}

model Post {
  id             Int            @id @default(autoincrement())
  userId         Int
  description    String?
  imageUrl       String[]       @default([])
  createdAt      DateTime       @default(now())
  deletionStatus DeletionStatus @default(NotDeleted)
  user           User           @relation(fields: [userId], references: [id])
}

model Device {
  id             String         @id @db.Uuid
  userId         Int
  title          String
  ip             String
  lastActiveDate DateTime
  expirationDate DateTime
  deletionStatus DeletionStatus @default(NotDeleted)
  user           User           @relation("Devices", fields: [userId], references: [id])
}

model Subscription {
  id              Int      @id @default(autoincrement())
  userId          Int
  planName        String
  expireAt        DateTime
  nextPaymentDate DateTime
  autoRenewal     Boolean  @default(false)
  paymentMethod   String
  isActive        Boolean
  user            User     @relation("Subscription", fields: [userId], references: [id])
}

model SubscriptionPayments {
  id    Int    @id @default(autoincrement())
  title String
  price Int
}

model Payments {
  id                    Int           @id @default(autoincrement())
  productIds            Int
  price                 Int
  paymentSystems        String
  status                PaymentStatus @default(PandingPayment)
  createAt              DateTime
  updareAt              DateTime
  url                   String
  anyPaymentsSystemData String?
  userId                Int
  user                  User          @relation("Payments", fields: [userId], references: [id])
}
